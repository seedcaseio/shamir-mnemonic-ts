{
  "name": "shamir-mnemonic-ts",
  "version": "1.3.0",
  "description": "TypeScript implementation of SLIP-0039 Shamir Secret Sharing for mnemonic seed phrases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decode": {
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    },
    "./wordlist": {
      "types": "./dist/wordlist.d.ts",
      "default": "./dist/wordlist.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:vectors": "jest test_vectors",
    "test:dist": "jest --testMatch \"**/tests/dist.smoke.ts\"",
    "prepublishOnly": "npm test",
    "prepack": "npm run build && npm run test:dist"
  },
  "keywords": [
    "shamir",
    "secret-sharing",
    "mnemonic",
    "slip-0039",
    "cryptography"
  ],
  "author": {
    "name": "Seedcase",
    "email": "contact@seedcase.io",
    "url": "https://seedcase.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedcaseio/shamir-mnemonic-ts.git"
  },
  "homepage": "https://github.com/seedcaseio/shamir-mnemonic-ts#readme",
  "bugs": {
    "url": "https://github.com/seedcaseio/shamir-mnemonic-ts/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0"
  }
}
